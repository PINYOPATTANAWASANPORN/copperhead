(pcb "board"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "copperhead")
    (host_version "pcb-layout-framework")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0 100300 -100300  135700 -100300  135700 -125700  100300 -125700  100300 -100300)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 250)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component Package_SO:SOIC-8_3.9x4.9mm_P1.27mm
      (place U1 116000 -113000 front 0 (PN "MCU"))
    )
    (component Capacitor_SMD:C_0603_1608Metric
      (place C1 116000 -106500 front 0 (PN "100n"))
    )
    (component Resistor_SMD:R_0603_1608Metric
      (place R1 124000 -108000 front 0 (PN "10k"))
      (place R2 124000 -118000 front 0 (PN "10k"))
    )
    (component Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm
      (place Y1 107000 -118000 front 0 (PN "8MHz"))
    )
    (component Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical
      (place J1 132000 -109000 front 0 (PN "CONN"))
    )
  )
  (library
    (image Package_SO:SOIC-8_3.9x4.9mm_P1.27mm
      (outline (path signal 0 -3700 2700  3700 2700  3700 -2700  -3700 -2700  -3700 2700))
