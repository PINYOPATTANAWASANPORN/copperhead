      (pin "RoundRect[T]Pad_1950x600_um_0_57b04a0" 5 2475 -1905)
      (pin "RoundRect[T]Pad_1950x600_um_0_57b04a0" 6 2475 -635)
      (pin "RoundRect[T]Pad_1950x600_um_0_57b04a0" 7 2475 635)
      (pin "RoundRect[T]Pad_1950x600_um_0_57b04a0" 8 2475 1905)
