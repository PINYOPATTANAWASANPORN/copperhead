    (padstack "RoundRect[T]Pad_900x950_um_0_11387c4"
      (shape (polygon F.Cu 0 450 -250  446 -294  433 -336  412 -375  384 -409  350 -437  311 -458  269 -471  225 -475  -225 -475  -269 -471  -311 -458  -350 -437  -384 -409  -412 -375  -433 -336  -446 -294  -450 -250  -450 250  -446 294  -433 336  -412 375  -384 409  -350 437  -311 458  -269 471  -225 475  225 475  269 471  311 458  350 437  384 409  412 375  433 336  446 294  450 250))
