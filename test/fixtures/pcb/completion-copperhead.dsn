      (pin "RoundRect[T]Pad_800x950_um_0_b337d3f4" 1 -825 0)
      (pin "RoundRect[T]Pad_800x950_um_0_b337d3f4" 2 825 0)
    )
    (image Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm
      (outline (path signal 0 -2100 1750  2100 1750  2100 -1750  -2100 -1750  -2100 1750))
      (pin "RoundRect[T]Pad_1400x1200_um_0_f8b4a964" 1 -1100 -850)
      (pin "RoundRect[T]Pad_1400x1200_um_0_f8b4a964" 2 1100 -850)
