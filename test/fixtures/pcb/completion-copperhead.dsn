  )
  (network
    (net GND
      (pins U1-4 C1-2 Y1-2 Y1-4 J1-2)
    )
    (net SIG1
      (pins U1-1 R1-2 J1-3)
    )
    (net SIG2
      (pins U1-2 R2-2 J1-4)
    )
    (net VCC
      (pins U1-8 C1-1 R1-1 R2-1 J1-1)
    )
    (net XI
      (pins U1-5 Y1-1)
    )
    (net XO
      (pins U1-6 Y1-3)
    )
    (class kicad_default GND SIG1 SIG2 VCC XI XO
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
